# Backend settings. Copy to server/.env and fill in; server/.env is never
# committed or served. Restart the site (Stop → start app) after changes.

# Email notifications about new leads. false = dev mode: leads are saved,
# nothing is sent. Set to true only with real SMTP settings below.
EMAIL_ENABLED=false

# SMTP of the sending mailbox. Yandex: smtp.yandex.ru, port 465, SMTP_SECURITY=ssl,
# SMTP_PASSWORD = an app password (id.yandex.ru → Security → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=

# Sender (defaults to SMTP_USER) and recipient of notifications.
LEAD_EMAIL_FROM=
LEAD_EMAIL_TO=Mylnikova.Viktoria.job@yandex.ru

# Optional
# TIMEZONE=Europe/Moscow        time zone used in emails
# LEADS_RATE_LIMIT=5            accepted leads per visitor IP per 10 minutes
# DATABASE_PATH=                default: server/data/leads.db
# API_DOCS=false                true exposes /api/docs (development only)
